# 仅供独立产品 profile 启动前参考；项目不会自动加载 .env 文件。
# 请在 PowerShell 或受管进程环境中设置需要覆盖的变量；不要提交真实 .env。

# 产品数据根目录；留空使用当前工作目录下的 .runtime/bot-data。
BOT_HOME=
# 工作区根目录；留空使用当前工作目录下的 .runtime/workspaces，首次安装后记录到 workspace.json。
BOT_WORKSPACE_ROOT=
# 媒体 worker 的 Python 3.12/3.13 解释器；留空使用安装器创建的媒体环境。
BOT_PYTHON=

# 图片服务公开配置；地址必须是无凭据、无查询的 HTTPS 地址。
BOT_IMAGE_BASE_URL=<https-image-api-base-url>
BOT_IMAGE_MODEL=<image-model-name>
# 这里只填写变量名，不填写密钥值；密钥由运行环境安全注入。
BOT_IMAGE_KEY_ENV=IMAGE_ACCESS_KEY
# IMAGE_ACCESS_KEY=

# 媒体分析密钥由 Harness credentials 注入到短生命周期 worker；不要在此填写。
# BOT_ANALYSIS_API_KEY=

# 音色模型库根目录；留空后在面板“连接”中配置。
BOT_VOICE_MODELS_ROOT=<absolute-voice-model-root>
# Breeze-TTS-2.cpp HTTP 服务地址；留空使用面板默认地址。
BREEZE_TTS_URL=<breeze-tts-http-url>
# 可选外部项目目录；只在面板点击对应启动按钮时使用固定启动器。
GPT_SOVITS_ROOT=<gpt-sovits-project-root>
BREEZE_TTS_ROOT=<breeze-tts-project-root>
BREEZE_TTS_VOICES_ROOT=<breeze-tts-voices-directory>

# 可选安装层（仅 scripts/install.mjs；默认 core,basic-media）。
BOT_INSTALL_LAYERS=core,basic-media

# 不要手工设置：启动器每次生成随机 IPC nonce。
# BOT_LAUNCH_TOKEN=
