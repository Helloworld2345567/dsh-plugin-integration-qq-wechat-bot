{
  "skill": "voice-generation",
  "entry": "dsh_bot_runtime.skills.voice_generation.voice_api",
  "operations": [
    {
      "id": "voice_speak",
      "quotaUnits": 10,
      "inputKinds": [],
      "role": "tts",
      "deliver": true
    }
  ],
  "tools": [
    {
      "tool": {
        "name": "bot_voice",
        "description": "Generate speech for an explicit request. Success registers audio for delivery; use bot_music for downloads and bot_sing for covers.",
        "parameters": {
          "mode": {
            "type": "string",
            "enum": [
              "speak"
            ]
          },
          "text": {
            "type": "string",
            "required": true
          },
          "voice": {
            "type": "string"
          },
          "style": {
            "type": "string"
          },
          "speed": {
            "type": "number"
          },
          "format": {
            "type": "string",
            "enum": [
              "mp3",
              "wav"
            ]
          }
        }
      },
      "defaults": {
        "mode": "speak"
      },
      "routes": [
        {
          "match": {
            "mode": "speak"
          },
          "operation": "voice_speak"
        }
      ],
      "enabledRoles": [
        "tts"
      ],
      "permissionTool": "bot_voice"
    }
  ]
}
