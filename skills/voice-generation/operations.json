{
  "skill": "voice-generation",
  "worker": "scripts/voice_api.py",
  "operations": [
    {
      "id": "voice_speak",
      "quotaUnits": 10,
      "inputKinds": [],
      "role": "tts",
      "deliver": true
    }
  ],
  "tools": [
    {
      "tool": {
        "name": "bot_voice",
        "description": "按用户明确要求生成 AI 朗读语音并登记待发送附件。成功仅表示生成和登记完成，平台在本轮结束后尝试投递，不能提前声称已送达。歌曲下载用 bot_music，按人格音色翻唱歌曲用 bot_sing。",
        "parameters": {
          "mode": {
            "type": "string",
            "enum": [
              "speak"
            ]
          },
          "text": {
            "type": "string",
            "required": true
          },
          "voice": {
            "type": "string"
          },
          "style": {
            "type": "string"
          },
          "speed": {
            "type": "number"
          },
          "format": {
            "type": "string",
            "enum": [
              "mp3",
              "wav"
            ]
          }
        }
      },
      "defaults": {
        "mode": "speak"
      },
      "routes": [
        {
          "match": {
            "mode": "speak"
          },
          "operation": "voice_speak"
        }
      ],
      "enabledRoles": [
        "tts"
      ],
      "permissionTool": "bot_voice"
    }
  ]
}
