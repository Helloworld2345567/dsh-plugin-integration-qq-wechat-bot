{
  "skill": "media-analysis",
  "entry": "dsh_bot_runtime.skills.media_analysis.media_api",
  "operations": [
    {
      "id": "media_download",
      "quotaUnits": 1,
      "inputKinds": [],
      "urlRequiredError": "MEDIA_URL_REQUIRED"
    },
    {
      "id": "media_analysis",
      "quotaUnits": 1,
      "inputKinds": []
    },
    {
      "id": "transcribe",
      "quotaUnits": 50,
      "inputKinds": [
        "audio"
      ],
      "role": "asr",
      "recentInput": "audio",
      "requiredInputError": "AUDIO_INPUT_REQUIRED"
    },
    {
      "id": "video_analyze",
      "quotaUnits": 10,
      "inputKinds": [
        "video"
      ],
      "role": "video",
      "recentInput": "video",
      "exclusiveSourceError": "ONE_VIDEO_SOURCE_REQUIRED",
      "urlHosts": [
        "www.bilibili.com",
        "bilibili.com",
        "b23.tv",
        "www.douyin.com",
        "douyin.com",
        "v.douyin.com",
        "www.iesdouyin.com"
      ],
      "urlHostError": "UNSUPPORTED_VIDEO_PLATFORM"
    },
    {
      "id": "image_convert",
      "quotaUnits": 1,
      "inputKinds": [
        "image"
      ],
      "deliver": true,
      "localTransform": true,
      "requiredInputError": "ONE_MEDIA_INPUT_REQUIRED"
    },
    {
      "id": "image_compress",
      "quotaUnits": 1,
      "inputKinds": [
        "image"
      ],
      "deliver": true,
      "localTransform": true,
      "requiredInputError": "ONE_MEDIA_INPUT_REQUIRED"
    },
    {
      "id": "image_resize",
      "quotaUnits": 1,
      "inputKinds": [
        "image"
      ],
      "deliver": true,
      "localTransform": true,
      "requiredInputError": "ONE_MEDIA_INPUT_REQUIRED"
    },
    {
      "id": "convert_gif",
      "quotaUnits": 50,
      "inputKinds": [
        "video"
      ],
      "deliver": true,
      "localTransform": true,
      "requiredInputError": "ONE_MEDIA_INPUT_REQUIRED"
    },
    {
      "id": "convert_mp4",
      "quotaUnits": 50,
      "inputKinds": [
        "video"
      ],
      "deliver": true,
      "localTransform": true,
      "requiredInputError": "ONE_MEDIA_INPUT_REQUIRED"
    }
  ],
  "tools": [
    {
      "tool": {
        "name": "media_download",
        "description": "Download an image, image gallery or video from a supported HTTPS URL into current-session attachments. Does not analyze media.",
        "parameters": {
          "url": {
            "type": "string",
            "required": true
          },
          "deliver": {
            "type": "boolean"
          }
        }
      },
      "defaults": {},
      "routes": [
        {
          "match": {},
          "operation": "media_download"
        }
      ]
    },
    {
      "tool": {
        "name": "media_analysis",
        "description": "Analyze current-session media attachments by ID. The host dispatches image, document, audio and video inputs.",
        "parameters": {
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "required": true
          },
          "question": {
            "type": "string"
          }
        }
      },
      "defaults": {},
      "routes": [
        {
          "match": {},
          "operation": "media_analysis"
        },
        {
          "match": {
            "_dispatch": "transcribe"
          },
          "operation": "transcribe"
        },
        {
          "match": {
            "_dispatch": "video_analyze"
          },
          "operation": "video_analyze"
        }
      ]
    },
    {
      "tool": {
        "name": "media_transform",
        "description": "Convert or compress current-session image and video attachments locally. Inputs must be attachment IDs; no URL is accepted.",
        "parameters": {
          "operation": {
            "type": "string",
            "enum": [
              "image_convert",
              "image_compress",
              "image_resize",
              "convert_gif",
              "convert_mp4"
            ],
            "required": true
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "required": true
          },
          "format": {
            "type": "string",
            "enum": [
              "jpeg",
              "png",
              "webp",
              "avif"
            ]
          },
          "quality": {
            "type": "number"
          },
          "maxWidth": {
            "type": "number"
          },
          "maxHeight": {
            "type": "number"
          },
          "maxBytes": {
            "type": "number"
          },
          "startSeconds": {
            "type": "number"
          },
          "durationSeconds": {
            "type": "number"
          },
          "fps": {
            "type": "number"
          }
        }
      },
      "defaults": {},
      "routes": [
        {
          "match": {
            "operation": "image_convert"
          },
          "operation": "image_convert"
        },
        {
          "match": {
            "operation": "image_compress"
          },
          "operation": "image_compress"
        },
        {
          "match": {
            "operation": "image_resize"
          },
          "operation": "image_resize"
        },
        {
          "match": {
            "operation": "convert_gif"
          },
          "operation": "convert_gif"
        },
        {
          "match": {
            "operation": "convert_mp4"
          },
          "operation": "convert_mp4"
        }
      ]
    }
  ]
}
