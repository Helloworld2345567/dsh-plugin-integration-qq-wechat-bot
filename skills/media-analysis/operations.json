{
  "skill": "media-analysis",
  "entry": "dsh_bot_runtime.skills.media_analysis.media_api",
  "operations": [
    {
      "id": "image_download",
      "quotaUnits": 1,
      "inputKinds": [],
      "deliver": true,
      "urlRequiredError": "IMAGE_URL_REQUIRED"
    },
    {
      "id": "transcribe",
      "quotaUnits": 50,
      "inputKinds": [
        "audio"
      ],
      "role": "asr",
      "recentInput": "audio",
      "requiredInputError": "AUDIO_INPUT_REQUIRED"
    },
    {
      "id": "video_download",
      "quotaUnits": 1,
      "inputKinds": [],
      "deliver": true,
      "urlRequiredError": "VIDEO_URL_REQUIRED",
      "exclusiveSourceError": "ONE_VIDEO_SOURCE_REQUIRED",
      "urlHosts": [
        "www.bilibili.com",
        "bilibili.com",
        "b23.tv",
        "www.douyin.com",
        "douyin.com",
        "v.douyin.com",
        "www.iesdouyin.com"
      ],
      "urlHostError": "UNSUPPORTED_VIDEO_PLATFORM"
    },
    {
      "id": "video_analyze",
      "quotaUnits": 10,
      "inputKinds": [
        "video"
      ],
      "role": "video",
      "recentInput": "video",
      "exclusiveSourceError": "ONE_VIDEO_SOURCE_REQUIRED",
      "urlHosts": [
        "www.bilibili.com",
        "bilibili.com",
        "b23.tv",
        "www.douyin.com",
        "douyin.com",
        "v.douyin.com",
        "www.iesdouyin.com"
      ],
      "urlHostError": "UNSUPPORTED_VIDEO_PLATFORM"
    },
    {
      "id": "image_convert",
      "quotaUnits": 1,
      "inputKinds": [
        "image"
      ],
      "deliver": true,
      "localTransform": true,
      "requiredInputError": "ONE_MEDIA_INPUT_REQUIRED"
    },
    {
      "id": "image_compress",
      "quotaUnits": 1,
      "inputKinds": [
        "image"
      ],
      "deliver": true,
      "localTransform": true,
      "requiredInputError": "ONE_MEDIA_INPUT_REQUIRED"
    },
    {
      "id": "image_resize",
      "quotaUnits": 1,
      "inputKinds": [
        "image"
      ],
      "deliver": true,
      "localTransform": true,
      "requiredInputError": "ONE_MEDIA_INPUT_REQUIRED"
    },
    {
      "id": "convert_gif",
      "quotaUnits": 50,
      "inputKinds": [
        "video"
      ],
      "deliver": true,
      "localTransform": true,
      "requiredInputError": "ONE_MEDIA_INPUT_REQUIRED"
    }
  ],
  "tools": [
    {
      "tool": {
        "name": "media_analysis",
        "description": "Run managed media analysis: kind=image downloads original images from url and registers image attachments; kind=audio transcribes speech; kind=video analyzes video, or only downloads and returns video with action=download. Reuses native model provider URLs and credentials without another key. Video supports Douyin/Bilibili post and share links; Douyin note/slides links require kind=image. Extract the HTTPS link from shared text into url; do not replace video analysis with web scraping. Use current-session attachment IDs; url and inputs are mutually exclusive. With neither, select the latest same-kind attachment. Returns actual analysis and coverage.",
        "parameters": {
          "kind": {
            "type": "string",
            "enum": [
              "audio",
              "video",
              "image"
            ],
            "required": true
          },
          "action": {
            "type": "string",
            "enum": [
              "analyze",
              "download"
            ]
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "question": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "defaults": {
        "action": "analyze"
      },
      "routes": [
        {
          "match": {
            "kind": "audio",
            "action": "analyze"
          },
          "operation": "transcribe"
        },
        {
          "match": {
            "kind": "image"
          },
          "operation": "image_download"
        },
        {
          "match": {
            "kind": "video",
            "action": "download"
          },
          "operation": "video_download"
        },
        {
          "match": {
            "kind": "video",
            "action": "analyze"
          },
          "operation": "video_analyze"
        }
      ],
      "enabledRoles": [
        "asr",
        "video"
      ]
    },
    {
      "tool": {
        "name": "media_transform",
        "description": "Quickly process one current-session attachment locally; concurrent calls are supported. image_convert/image_compress/image_resize convert, compress and proportionally downsize JPEG/PNG/WebP/AVIF, combining format/quality/maxWidth/maxHeight/maxBytes. convert_gif defaults to the complete video at 12 fps and a 480-pixel longest edge. Long videos encode in concurrent segments and merge into a GIF strictly below 10 MB. Reduce size/colors without shortening duration or dropping below 12 fps. startSeconds/durationSeconds require an explicitly requested excerpt. Success automatically registers attachments; no model or key is required.",
        "parameters": {
          "operation": {
            "type": "string",
            "enum": [
              "image_convert",
              "image_compress",
              "image_resize",
              "convert_gif"
            ],
            "required": true
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "required": true
          },
          "format": {
            "type": "string",
            "enum": [
              "jpeg",
              "png",
              "webp",
              "avif"
            ]
          },
          "quality": {
            "type": "number"
          },
          "maxWidth": {
            "type": "number"
          },
          "maxHeight": {
            "type": "number"
          },
          "maxBytes": {
            "type": "number"
          },
          "startSeconds": {
            "type": "number"
          },
          "durationSeconds": {
            "type": "number"
          },
          "fps": {
            "type": "number"
          }
        }
      },
      "defaults": {},
      "routes": [
        {
          "match": {
            "operation": "image_convert"
          },
          "operation": "image_convert"
        },
        {
          "match": {
            "operation": "image_compress"
          },
          "operation": "image_compress"
        },
        {
          "match": {
            "operation": "image_resize"
          },
          "operation": "image_resize"
        },
        {
          "match": {
            "operation": "convert_gif"
          },
          "operation": "convert_gif"
        }
      ]
    }
  ]
}
