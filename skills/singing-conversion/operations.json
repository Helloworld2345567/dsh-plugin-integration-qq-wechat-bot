{
  "skill": "singing-conversion",
  "entry": "dsh_bot_runtime.skills.singing_conversion.entry",
  "operations": [{"id":"singing_convert","quotaUnits":10,"inputKinds":["audio","file"],"deliver":true}],
  "tools": [{
    "permissionTool":"bot_sing",
    "tool": {
      "name":"bot_sing",
      "description":"Sing a requested song in the current persona AI voice. Use sing with a song title; the host selects the highest catalog match, downloads the original, separates vocals and converts them. Only the converted result is delivered by default. For attachments or explicit HTTPS sources, use prepare/list/convert. Mixed audio requires configured separation.",
      "parameters": {
        "action":{"type":"string","enum":["sing","prepare","list","convert"],"required":true},
        "song":{"type":"string"},
        "artist":{"type":"string"},
        "inputs":{"type":"array","items":{"type":"string"}},
        "title":{"type":"string"},
        "url":{"type":"string"},
        "candidates":{"type":"array","items":{"type":"object","additionalProperties":false,"properties":{"title":{"type":"string","required":true},"url":{"type":"string","required":true},"source":{"type":"string"},"license":{"type":"string"}}}},
        "candidateSet":{"type":"string"},
        "candidate":{"type":"number"},
        "sourceType":{"type":"string","enum":["vocals","mixed","unknown"]},
        "format":{"type":"string","enum":["mp3","wav"]}
      }
    },
    "defaults":{"action":"list"},
    "routes":[{"match":{"action":"convert"},"operation":"singing_convert"},{"match":{"action":"sing"},"operation":"singing_convert"}]
  }]
}
