{
  "name": "dsh-plugin-integration-qq-wechat-bot",
  "version": "0.2.2",
  "description": "Native DeepSeek Harness QQ and WeChat bots with hot-switchable personas and media tools",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Helloworld2345567/dsh-plugin-integration-qq-wechat-bot.git"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*.js",
    "cordis.patch.yml",
    "python/**/*.py",
    "skills/**/*.md",
    "skills/**/*.py",
    "skills/**/operations.json",
    "scripts/install.mjs",
    "scripts/start.mjs",
    "scripts/stop.mjs",
    "scripts/runtime.mjs",
    "scripts/windows.ps1",
    "requirements.txt",
    "packages/bot-unified-chat",
    "docs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "packages/bot-lifecycle",
    "scripts/installation.mjs",
    "scripts/supervisor.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:native": "node scripts/test-native.mjs",
    "test:python": "python -m unittest discover -s tests -p test_*.py",
    "check:release": "node scripts/check-release.mjs",
    "start": "node scripts/start.mjs",
    "stop": "node scripts/stop.mjs",
    "test:lifecycle-native": "node scripts/test-lifecycle-native.mjs",
    "test:install-smoke": "node scripts/test-install-smoke.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "json-bigint": "^1.0.0",
    "qrcode": "^1.5.4",
    "silk-wasm": "^3.7.1",
    "yaml": "^2.8.1",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-terminal": "0.2.1-rc.2"
  },
  "devDependencies": {
    "@types/json-bigint": "^1.0.4",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.11",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
