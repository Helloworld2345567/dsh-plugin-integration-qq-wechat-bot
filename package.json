{
  "name": "dsh-plugin-integration-qq-wechat-bot",
  "version": "0.2.10",
  "description": "Native DeepSeek Harness QQ and WeChat bots with hot-switchable personas and media tools",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Helloworld2345567/dsh-plugin-integration-qq-wechat-bot.git"
  },
  "engines": {
    "node": ">=24.0.0",
    "dsh": "0.2.1-rc.2"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "python/**/*.py",
    "skills/**/*.md",
    "skills/**/*.py",
    "skills/**/operations.json",
    "scripts/install.mjs",
    "scripts/release-safety.mjs",
    "scripts/release-safety.d.mts",
    "scripts/archive-validation.d.mts",
    "scripts/github-bootstrap.d.mts",
    "scripts/installation.d.mts",
    "scripts/start.mjs",
    "scripts/stop.mjs",
    "scripts/runtime.mjs",
    "scripts/check-environment.mjs",
    "scripts/check-contracts.mjs",
    "scripts/check-architecture.mjs",
    "scripts/check-architecture.d.mts",
    "scripts/test-environment.mjs",
    "scripts/test-process.mjs",
    "scripts/test-python.mjs",
    "scripts/archive-validation.mjs",
    "scripts/durable-json.mjs",
    "scripts/durable-json.d.mts",
    "scripts/release-pack.mjs",
    "scripts/audit-dependencies.mjs",
    "scripts/check-docs.mjs",
    "scripts/check-licenses.mjs",
    "scripts/check-python-dependencies.mjs",
    "scripts/github-bootstrap.mjs",
    "scripts/bootstrap-github.mjs",
    "scripts/windows.ps1",
    "requirements.txt",
    "requirements-voice-generation.txt",
    "requirements-ci.txt",
    "requirements-voice-generation-ci.txt",
    "docs",
    ".env.example",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "CHANGELOG.md",
    "SUPPORT.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "packages/bot-lifecycle",
    "scripts/installation.mjs",
    "scripts/supervisor.mjs",
    "scripts/workspace-storage.mjs"
  ],
  "dshLifecycle": {
    "schemaVersion": 1,
    "role": "main",
    "runtimeProtocol": "2.1.0",
    "coordinatorApiRange": ">=2.0.0 <3.0.0",
    "capabilities": [
      "runtime.health",
      "runtime.quiesce",
      "runtime.resume",
      "upgrade.main-hot"
    ],
    "requiredCoordinatorCapabilities": [
      "coordinator.tick",
      "upgrade.main-hot",
      "upgrade.offline-pair"
    ]
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-typescript.mjs",
    "test:native": "node scripts/test-native.mjs",
    "test:python": "node scripts/test-python.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:python-dependencies": "node scripts/check-python-dependencies.mjs",
    "check:environment": "node scripts/check-environment.mjs",
    "check:contracts": "node scripts/check-contracts.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "verify:release": "npm run check:architecture && npm run typecheck && npm test && npm run test:python && npm run check:python-dependencies && npm run build && npm run check:docs && npm run check:contracts && npm run check:licenses && npm run check:release",
    "release:pack": "npm run verify:release && node scripts/release-pack.mjs",
    "prepublishOnly": "npm run verify:release",
    "start": "node scripts/start.mjs",
    "stop": "node scripts/stop.mjs",
    "test:lifecycle-native": "node scripts/test-lifecycle-native.mjs",
    "test:install-smoke": "node scripts/test-install-smoke.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "json-bigint": "^1.0.0",
    "qrcode": "^1.5.4",
    "silk-wasm": "^3.7.1",
    "yaml": "^2.8.1",
    "ws": "^8.22.1",
    "zod": "^4.1.12"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-terminal": "0.2.1-rc.2"
  },
  "devDependencies": {
    "@types/json-bigint": "^1.0.4",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.11",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
